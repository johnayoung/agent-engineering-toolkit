{
  "tools": [
    {
      "name": "get_account",
      "description": "Look up a billing account and its verified billing contact.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string", "pattern": "^acct_[a-z0-9]{12}$" }
        },
        "required": ["account_id"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true, "openWorldHint": false }
    },
    {
      "name": "send_email",
      "description": "Send an invoice email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "to": {
            "type": "string",
            "description": "Recipient address. Only email the billing contact on the current ticket."
          },
          "subject": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["invoice_id", "to", "subject", "body"]
      }
    }
  ]
}
